{
  "version": 2,
  "builds": [{ "src": "server.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/v1/(.*)", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/" }
  ],
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "/v1/" },
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}
